package std.string;
import std.mem;

// PLang 标准库：字符串操作（char* 字符串，\0 结尾）。
// 用法：
//   var: string s = "hello";
//   var: int n = str.len(s);          // 5
//   var: string t = str.cat(s, "!");  // "hello!"（堆上新字符串，用完 free）
//   if (str.eq(s, "hello")) { ... }
//   var: int c = str.cmp(a, b);       // 字典序比较
//   var: string d = str.dup(s);       // 复制（堆上新字符串）
// str.cat/str.dup 返回堆内存，调用方需 mem.free 释放。

// extern C 声明（LLVM declare，不生成定义）；memcpy 复用 std.mem 的
extern func strlen(var -> var: ptr s) : i64;
extern func strcmp(var -> var: ptr a, var -> var: ptr b) : int;

// 字符串长度（不含末尾 \0）
pub func len(var -> var: ptr s) : int {
    var: i64 n = strlen(s);
    return int as n;
}

// 拼接 a + b，返回新分配的堆字符串（调用方 free）
pub func cat(var -> var: ptr a, var -> var: ptr b) -> var: ptr {
    var: i64 la = strlen(a);
    var: i64 lb = strlen(b);
    var -> var: char m = mem.malloc(la + lb + 1);
    mem.memcpy(m, a, la);
    mem.memcpy(m + la, b, lb);
    m[la + lb] = '\0';
    return m;
}

// 复制字符串，返回新分配的堆字符串（调用方 free）
pub func dup(var -> var: ptr s) -> var: ptr {
    var: i64 n = strlen(s);
    var -> var: ptr m = mem.malloc(n + 1);
    mem.memcpy(m, s, n + 1);   // 连末尾 \0 一起复制
    return m;
}

// 内容相等比较（非指针比较）
pub func eq(var -> var: ptr a, var -> var: ptr b) : bool {
    return strcmp(a, b) == 0;
}

// 字典序比较：<0 / 0 / >0
pub func cmp(var -> var: ptr a, var -> var: ptr b) : int {
    return strcmp(a, b);
}

// —— 以下为自举用扩展：子串/查找/大小写/替换/解析 ——
// 带字符索引的函数用 char* 类型参数；返回堆内存的调用方 mem.free。

// 截取子串 s[start .. start+n)，越界自动裁剪。返回堆内存（调用方 free）
pub func sub(var -> var: char s, val: int start, val: int n) -> var: ptr {
    var: int sl = len(s);
    var: int begin = start;
    if (begin < 0) begin = 0;
    if (begin > sl) begin = sl;
    var: int count = n;
    if (count < 0) count = 0;
    if (begin + count > sl) count = sl - begin;
    var -> var: char out = mem.malloc(count + 1);
    if (out == null) return null;
    var: int i = 0;
    while (i < count) {
        out[i] = s[begin + i];
        i = i + 1;
    }
    out[count] = '\0';
    return out;
}

// 查找子串首次出现位置，未找到返回 -1
pub func find(var -> var: char hay, var -> var: char needle) : int {
    var: int hl = len(hay);
    var: int nl = len(needle);
    if (nl == 0) return 0;
    var: int i = 0;
    while (i <= hl - nl) {
        var: bool m = true;
        var: int j = 0;
        while (j < nl) {
            if (hay[i + j] != needle[j]) {
                m = false;
                j = nl;
            }
            j = j + 1;
        }
        if (m) return i;
        i = i + 1;
    }
    return -1;
}

// 查找子串最后一次出现位置，未找到返回 -1
pub func rfind(var -> var: char hay, var -> var: char needle) : int {
    var: int hl = len(hay);
    var: int nl = len(needle);
    if (nl == 0) return hl;
    var: int i = hl - nl;
    while (i >= 0) {
        var: bool m = true;
        var: int j = 0;
        while (j < nl) {
            if (hay[i + j] != needle[j]) {
                m = false;
                j = nl;
            }
            j = j + 1;
        }
        if (m) return i;
        i = i - 1;
    }
    return -1;
}

// 是否包含子串
pub func contains(var -> var: char hay, var -> var: char needle) : bool {
    return find(hay, needle) >= 0;
}

// 前缀匹配
pub func startsWith(var -> var: char s, var -> var: char prefix) : bool {
    var: int sl = len(s);
    var: int pl = len(prefix);
    if (pl > sl) return false;
    var: int i = 0;
    while (i < pl) {
        if (s[i] != prefix[i]) return false;
        i = i + 1;
    }
    return true;
}

// 后缀匹配
pub func endsWith(var -> var: char s, var -> var: char suffix) : bool {
    var: int sl = len(s);
    var: int pl = len(suffix);
    if (pl > sl) return false;
    var: int i = 0;
    while (i < pl) {
        if (s[sl - pl + i] != suffix[i]) return false;
        i = i + 1;
    }
    return true;
}

// 去除首尾空白（空格/制表/换行/回车）的副本（调用方 free）
// 注意：编译器 && 不做短路，避免对 s[begin-1] 之类越界求值，用标志位
pub func trim(var -> var: char s) -> var: ptr {
    var: int sl = len(s);
    var: int begin = 0;
    var: bool bDone = false;
    while (begin < sl && !bDone) {
        if (isSpace(s[begin])) {
            begin = begin + 1;
        } else {
            bDone = true;
        }
    }
    var: int end = sl;
    var: bool eDone = false;
    while (end > begin && !eDone) {
        if (isSpace(s[end - 1])) {
            end = end - 1;
        } else {
            eDone = true;
        }
    }
    return sub(s, begin, end - begin);
}

// 大写副本（调用方 free）
pub func toUpper(var -> var: char s) -> var: ptr {
    var: int sl = len(s);
    var -> var: char out = mem.malloc(sl + 1);
    if (out == null) return null;
    var: int i = 0;
    while (i < sl) {
        out[i] = toUpperChar(s[i]);
        i = i + 1;
    }
    out[sl] = '\0';
    return out;
}

// 小写副本（调用方 free）
pub func toLower(var -> var: char s) -> var: ptr {
    var: int sl = len(s);
    var -> var: char out = mem.malloc(sl + 1);
    if (out == null) return null;
    var: int i = 0;
    while (i < sl) {
        out[i] = toLowerChar(s[i]);
        i = i + 1;
    }
    out[sl] = '\0';
    return out;
}

// 替换所有出现的 from 为 to。返回堆内存（调用方 free）
pub func replace(var -> var: char s, var -> var: char from, var -> var: char to) -> var: ptr {
    var: int ls = len(s);
    var: int lf = len(from);
    var: int lt = len(to);
    if (lf == 0) {
        return dup(s);
    }
    var: int cnt = 0;
    var: int i = 0;
    while (i <= ls - lf) {
        var: bool m = true;
        var: int j = 0;
        while (j < lf) {
            if (s[i + j] != from[j]) {
                m = false;
                j = lf;
            }
            j = j + 1;
        }
        if (m) {
            cnt = cnt + 1;
            i = i + lf;
        } else {
            i = i + 1;
        }
    }
    var: int newLen = ls - cnt * lf + cnt * lt;
    var -> var: char out = mem.malloc(newLen + 1);
    if (out == null) return null;
    var: int k = 0;
    i = 0;
    while (i < ls) {
        var: bool m2 = true;
        var: int j2 = 0;
        while (j2 < lf) {
            var: bool oob = false;
            if (i + j2 >= ls) {
                oob = true;
            } else if (s[i + j2] != from[j2]) {
                oob = true;
            }
            if (oob) {
                m2 = false;
                j2 = lf;
            }
            j2 = j2 + 1;
        }
        if (m2) {
            var: int t = 0;
            while (t < lt) {
                out[k] = to[t];
                t = t + 1;
                k = k + 1;
            }
            i = i + lf;
        } else {
            out[k] = s[i];
            k = k + 1;
            i = i + 1;
        }
    }
    out[k] = '\0';
    return out;
}

// 按 base（2/8/10/16）解析字符串，失败返回 0
pub func parseInt(var -> var: char s, val: int base) : i64 {
    var: int sl = len(s);
    var: int i = 0;
    var: bool neg = false;
    if (i < sl && (s[i] == '-' || s[i] == '+')) {
        neg = s[i] == '-';
        i = i + 1;
    }
    var: int v = 0;
    var: bool any = false;
    while (i < sl) {
        var: char c = s[i];
        var: int d = -1;
        if (c >= '0' && c <= '9') {
            d = int as c - int as '0';
        } else if (c >= 'a' && c <= 'f') {
            d = int as c - int as 'a' + 10;
        } else if (c >= 'A' && c <= 'F') {
            d = int as c - int as 'A' + 10;
        }
        if (d < 0 || d >= base) {
            i = sl;
        } else {
            v = v * base + d;
            any = true;
            i = i + 1;
        }
    }
    if (!any) return i64 as 0;
    if (neg) return i64 as (0 - v);
    return i64 as v;
}

// 整数 → 十进制堆字符串（调用方 free）
pub func intToStr(val: i64 n) -> var: ptr {
    var: i64 v = n;
    var: bool neg = false;
    if (v < 0) {
        neg = true;
        v = 0 - v;
    }
    var: char[32] buf;
    var: int i = 0;
    if (v == 0) {
        buf[i] = '0';
        i = i + 1;
    } else {
        while (v > 0) {
            buf[i] = char as (int as (v % 10) + int as '0');
            v = v / 10;
            i = i + 1;
        }
    }
    var: int j = 0;
    while (j < i / 2) {
        var: char tmp = buf[j];
        buf[j] = buf[i - 1 - j];
        buf[i - 1 - j] = tmp;
        j = j + 1;
    }
    if (neg) {
        var: int k = i;
        while (k > 0) {
            buf[k] = buf[k - 1];
            k = k - 1;
        }
        buf[0] = '-';
        i = i + 1;
    }
    buf[i] = '\0';
    return dup(&buf);
}

// 字符分类与大小写
pub func isDigit(val: char c) : bool {
    return c >= '0' && c <= '9';
}

pub func isAlpha(val: char c) : bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

pub func isSpace(val: char c) : bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

pub func isAlnum(val: char c) : bool {
    return isDigit(c) || isAlpha(c);
}

pub func isUpper(val: char c) : bool {
    return c >= 'A' && c <= 'Z';
}

pub func isLower(val: char c) : bool {
    return c >= 'a' && c <= 'z';
}

pub func toUpperChar(val: char c) : char {
    if (c >= 'a' && c <= 'z') {
        return char as (int as c - 32);
    }
    return c;
}

pub func toLowerChar(val: char c) : char {
    if (c >= 'A' && c <= 'Z') {
        return char as (int as c + 32);
    }
    return c;
}
