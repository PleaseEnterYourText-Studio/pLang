package std.time;
import std.mem;

// PLang 标准库：时间（extern 直通 libc）。
// 用法：
//   var: i64 ms = time.monotonicMs();   // 程序内单调时钟（性能测量）
//   var: i64 t  = time.epoch();         // Unix 秒（墙钟）

extern func time(var -> var: ptr t) : i64;
extern func clock() : i64;
extern func clock_gettime(val: int clockid, var -> var: ptr ts) : int;

// struct timespec { time_t tv_sec; long tv_nsec; }（64 位平台两字段各 8 字节）
using Timespec = struct {
    pub val: i64 tv_sec;
    pub val: i64 tv_nsec;
};

// Unix 时间戳（自 1970-01-01 的秒数）
pub func epoch() : i64 {
    return time(null);
}

// 进程 CPU 时钟（clock_t，除以 CLOCKS_PER_SEC 即秒，POSIX 为 1e6）
pub func cpu() : i64 {
    return clock();
}

// CPU 时间（秒，f64）
pub func cpuSeconds() : f64 {
    var: i64 c = clock();
    return (f64 as c) / 1000000.0;
}

// 单调时钟毫秒（测量耗时，不受系统时间调整影响）
pub func monotonicMs() : i64 {
    var: Timespec ts = {0, 0};
    clock_gettime(1, &ts);   // CLOCK_MONOTONIC = 1
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}
