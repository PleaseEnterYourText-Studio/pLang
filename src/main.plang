package demo;
import std.vector;
import std.string;
import std.thread;
import std.io;
import std.atomic;
import std.mem;
import std.sqlite;

/* 块注释 */
// 行注释

// 匿名结构体 using
using Point = struct {
    pub val: int x;
    pub val: int y;
};

using Shape = abstract {
    pub func area() : f64;
};
using Circle = struct : pub Shape {
    pub val: f64 r;
    pub val: f64 r;
    pub func area() : f64 {
        return 3.14 * this.r * this.r;
    }
};

// 函数定义与调用
func add(val: int a, val: int b) : int {
    return a + b;
}

func useMoved(val: string s) : int {
    var: string copy = s;
    return 1;
}

// 共享内存线程：原子累加计数器 1000 次
func sharedWorker(var -> var: int counter) : int {
    var: int si = 0;
    while (si < 1000) {
        atomic.add(counter, 1);
        si = si + 1;
    }
    return 0;
}

// 线程入口：CPU 密集计算
func burn() : int {
    var: i64 i = 0;
    while (i < 2000000000) {
        i = i + 1;
    }
    return 0;
}

// 指针返回：func foo() -> var T（与 var -> var: T 的箭头写法统一）
// 借用检查：不能返回局部变量地址，改为返回参数指针（生命周期由调用方保证）
func getCounter(var -> var: int p) -> var: int {
    return p;
}

// 线程入口：休眠 50ms
func snooze() : int {
    thread.sleep(50);
    return 0;
}

func main() : int {
    // 基本类型变量
    var: i32 a = 42;
    val: i64 big = 0xFF;
    var: f64 pi = 3.14;
    var: string name = "plang";
    var: char c = 'x';
    var: bool flag = true;

    // 数字字面量进制
    var: u32 hex = 0xFF;
    var: u32 oct = 0o17;
    var: u32 bin = 0b1010;
    var: i64 l = 1ll;
    var: f32 f = 2.5f;

    // 类型推导
    var inferred = 100;

    // 指针与引用
    var -> var: int p = &a;
    var ref@a;
    *p = 1;

    // 指针返回（参数指针，借用检查合法）
    var -> var: int q = getCounter(&a);
    *q = 1;

    // 数组
    var: int[3] arr = {1, 2, 3};

    // 结构体实例化
    var: Point point = {10, 20};

    // 运算符
    var: int x = 1 + 2 * 3;
    var: bool cmp = (x >= 10) && (x != 5);
    var: int bit = (x & 1) | (x << 2);
    x += 5;
    x %= 3;
    x++;
    x--;

    // 类型转换
    var: int y = int as 3.14;

    // 控制流
    if (x > 10) {
        x = add(x, 1);
    } else if (x == 10) {
        x = add(x, 2);
    } else {
        x = add(x, 3);
    }

    while (x < 20) {
        x++;
    }

    for (var: int i = 0; i < 5; i++) {
        x = x + i;
    }

    // 函数调用
    var: int sum = add(10, 20);

    // 接口动态分派
    var: Circle circle = {5};
    var: f64 area = circle.area();

    // 两线程并行各跑 2e9 次循环
    var -> var: ptr t1 = thread.spawn(burn);
    var -> var: ptr t2 = thread.spawn(burn);
    thread.join(t1);
    thread.join(t2);

    // 休眠线程
    var -> var: ptr t3 = thread.spawn(snooze);
    thread.join(t3);

    // 互斥锁：创建 → 加锁 → 解锁 → 销毁
    var -> var: ptr m = thread.mutex.create();
    thread.lock(m);
    thread.unlock(m);
    thread.destroy(m);

    thread.yield();

    // 标准输入输出
    io.println("请输入一个整数:");
    var: int input = io.readInt();
    io.print("你输入了: ");
    io.printInt(input);
    io.println("");
    io.printFloat(3.14159);
    io.println("");
    io.printChar('!');
    io.println("");
    io.flush();

    // 万能格式化（变参 printf）
    io.printf("%s %d %x\n", "printf", 42, 255);

    // 并发共享状态：两线程原子累加共享计数器
    var: int sharedCounter = 0;
    var -> var: int scp = &sharedCounter;
    var -> var: ptr st1 = thread.spawn(sharedWorker, scp);
    var -> var: ptr st2 = thread.spawn(sharedWorker, scp);
    thread.join(st1);
    thread.join(st2);
    io.printInt(sharedCounter);
    io.println("");

    // 堆内存：分配 4 个 int，写入并释放
    var -> var: int hp = mem.malloc(16);
    if (hp != null) {
        hp[0] = 1;
        hp[1] = 2;
        io.printInt(hp[0] + hp[1]);
        io.println("");
        mem.free(hp);
    }

    // 基础容器：Vec<int> 动态数组（含扩容）
    var: Vec<int> v = vector.new<int>(2);
    vector.push<int>(&v, 10);
    vector.push<int>(&v, 20);
    vector.push<int>(&v, 30);
    io.printInt(vector.len<int>(&v));     // 3
    io.println("");
    io.printInt(vector.get<int>(&v, 0));  // 10
    io.println("");
    vector.destroy<int>(&v);

    // 字符串：长度 / 拼接 / 比较 / 复制
    var: string hello = "hello";
    var: string greeting = string.cat(hello, " world!");
    io.println(greeting);                 // hello world!
    if (string.eq(hello, "hello")) {
        io.println("str eq ok");
    }
    mem.free(greeting);

    // SQLite：建表、插入、按列取值（数据读进变量计算）
    var -> var: ptr db = sqlite.open("plang_demo.db");
    if (db != null) {
        sqlite.exec(db, "DROP TABLE IF EXISTS user");
        sqlite.exec(db, "CREATE TABLE user (id INT, name TEXT, score INT)");
        sqlite.exec(db, "INSERT INTO user VALUES (1, 'Alice', 90)");
        sqlite.exec(db, "INSERT INTO user VALUES (2, 'Bob', 75)");
        var -> var: ptr stmt = sqlite.prepare(db, "SELECT id, name, score FROM user");
        var: int total = 0;
        var: int n = 0;
        while (sqlite.step(stmt)) {
            io.printInt(sqlite.columnInt(stmt, 0));
            io.print(": ");
            io.println(sqlite.columnText(stmt, 1));
            total = total + sqlite.columnInt(stmt, 2);
            n = n + 1;
        }
        io.print("平均分=");
        io.printInt(total / n);           // 165 / 2 = 82
        io.println("");
        sqlite.finalize(stmt);
        sqlite.close(db);
    }

    return 82;
}
